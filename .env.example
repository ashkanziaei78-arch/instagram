# این فایل را کپی کنید به `.env.local` و مقادیر خودتان را بگذارید.
# `.env.local` در .gitignore است، پس اعتبارنامه‌تان وارد گیت نمی‌شود.
#
# اگر این فایل را پر نکنید اپ باز هم کار می‌کند — فقط کاربر باید همین سه مقدار
# را یک بار در «تنظیمات» وارد کند. پر کردنش یعنی کاربر نهایی هیچ تنظیمی نبیند.
#
# ⚠️ *Instagram* app id/secret لازم است، نه Facebook app id/secret.
#    جایشان: داشبورد متا → Instagram → API setup with Instagram login
#             → 3. Set up Instagram business login → Business login settings

IG_APP_ID=
IG_APP_SECRET=

# باید مو‌به‌مو با آدرس ثبت‌شده در Business login settings یکی باشد
IG_REDIRECT_URI=https://www.facebook.com/
