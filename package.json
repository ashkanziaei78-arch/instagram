{
  "name": "ig-auto-suite",
  "version": "1.0.0",
  "description": "اپ دسکتاپ مدیریت و اتوماسیون اینستاگرام",
  "main": "out/main/index.js",
  "author": "Ashkan",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "pack:win": "electron-vite build && electron-builder --win --publish never",
    "pack:dir": "electron-vite build && electron-builder --dir",
    "test:db": "esbuild scripts/test-db.ts --bundle --platform=node --format=cjs --external:node-sqlite3-wasm --outfile=.test-db.cjs --log-level=error && node .test-db.cjs",
    "test:matcher": "esbuild scripts/test-matcher.ts --bundle --platform=node --format=cjs --outfile=.test-matcher.cjs --log-level=error && node .test-matcher.cjs",
    "test": "npm run test:db && npm run test:matcher",
    "fix:electron": "node scripts/install-electron.mjs"
  },
  "dependencies": {
    "express": "^4.21.1",
    "node-sqlite3-wasm": "^0.8.30"
  },
  "optionalDependencies": {
    "instagram-private-api": "^1.46.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "postcss": "^8.4.49",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.13.3",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
