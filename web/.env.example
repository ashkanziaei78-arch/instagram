# آدرس نهایی سایت، بدون / آخر — Redirect URI متا می‌شود: <این>/oauth/instagram
NEXT_PUBLIC_SITE_URL=https://directino.vercel.app

# Postgres (Supabase / Neon / Postgres روی هاست ویندوز). جدول‌ها با پیشوند dx_ خودکار ساخته می‌شوند.
DATABASE_URL=postgres://user:pass@host:5432/db
# روی Postgres محلی بدون SSL: disable
DATABASE_SSL=

# یک رشته‌ی تصادفی بلند — امضای کوکی ورود و رمزنگاری توکن‌های اینستاگرام
SESSION_SECRET=

# اپ متا (Instagram API with Instagram Login) — فقط روی سرور، هرگز در کد
IG_APP_ID=
IG_APP_SECRET=
# همان رشته‌ای که در داشبورد متا برای Webhook می‌گذارید
WEBHOOK_VERIFY_TOKEN=

# نام کاربری‌ای که با ثبت‌نام مدیر می‌شود
ADMIN_USERNAME=

# زرین‌پال (خالی = پرداخت کارت‌به‌کارت و فعال‌سازی دستی از پنل مدیر)
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=
MANUAL_PAY_CARD=
MANUAL_PAY_CONTACT=

# لینک دانلود نسخه‌ی ویندوز
NEXT_PUBLIC_DESKTOP_URL=
